# PostgreSQL Database connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/shiv_erp?schema=public"

# Node environment
NODE_ENV="development"
PORT=5000

# Authentication secrets
JWT_ACCESS_SECRET="super_secret_access_key_development"
JWT_REFRESH_SECRET="super_secret_refresh_key_development"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Optional integrations
EMAIL_API_KEY=""
EMAIL_FROM=""
MAP_API_KEY=""
